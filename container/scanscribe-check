#!/usr/bin/env bash
# Quick health report for stage-1 testing.
echo "== USB devices (Realtek) =="
lsusb -d 0bda: || echo "none found - USB passthrough problem"
echo
echo "== Tuner test =="
timeout 8 rtl_test -t 2>&1 | head -15 || true
echo
echo "== Service =="
systemctl --no-pager status scanscribe-recorder | head -12
echo
echo "== Recent log =="
journalctl -u scanscribe-recorder -n 25 --no-pager
echo
echo "== Recordings =="
rec=/var/lib/scanscribe/recordings
count=$(find "$rec" -type f \( -name '*.m4a' -o -name '*.wav' \) 2>/dev/null | wc -l)
echo "$count audio files under $rec"
find "$rec" -type f \( -name '*.m4a' -o -name '*.wav' \) -printf '%TY-%Tm-%Td %TH:%TM  %p\n' 2>/dev/null | sort | tail -5
