# ScanScribe settings. Edit, then: systemctl restart scanscribe-recorder
SDR_DEVICE=rtl=0
SDR_RATE=2400000
# RTL-SDR tuner gain in dB. Tune this on your antenna (too high = overload/images, too low = weak signals missed).
SDR_GAIN=40
# Frequency correction. The NESDR SMArt has a 0.5 ppm TCXO, so 0 is right.
SDR_PPM=0
# Squelch in dB. Closer to 0 = stronger signal needed. Adjust after watching the logs.
ANALOG_SQUELCH=-50
P25_SQUELCH=-50
# P25 modulation: fsk4 (C4FM, typical for conventional P25) or qpsk (simulcast/LSM). Verify on air.
P25_MODULATION=fsk4
CAPTURE_DIR=/var/lib/scanscribe/recordings
# Calls shorter than this (seconds) are discarded.
MIN_DURATION=1.0
LOG_LEVEL=info

# --- Transcription (faster-whisper, CPU) ---
# Model: tiny.en / base.en / small.en / medium.en (bigger = more accurate, slower, more RAM). Restart scanscribe-transcribe after changing.
WHISPER_MODEL=small.en
WHISPER_THREADS=2
# Hint to the model about vocabulary/context (improves local names and radio phrases).
WHISPER_PROMPT=Police, fire and EMS radio dispatch in Concord, New Hampshire.
